# --- Dexra ---
# dxr_ key from https://dexra.dev/app/keys. Without it, paid checks answer 402, which blocks every buy.
DEXRA_API_KEY=
# Point at a local API for testing, e.g. http://127.0.0.1:3000
DEXRA_BASE_URL=https://api.dexra.dev

# --- Trading core (safety) ---
# Live trading needs DRY_RUN=false AND SOLANA_PRIVATE_KEY AND JUPITER_API_KEY. Anything less stays a dry run.
DRY_RUN=true
# Base58 64-byte secret key. Only for live trading. Use a dedicated wallet that holds little SOL.
SOLANA_PRIVATE_KEY=
# Sent to Jupiter as x-api-key. Needed for live trading, for quotes in a dry run, and for the exit loop.
JUPITER_API_KEY=
# Hard cap per buy, in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Jupiter slippage, whole number from 0 to 1000.
SLIPPAGE_BPS=100
# When true, a caution verdict from the core's re-check passes. Launch intake still takes only ok.
ALLOW_CAUTION=false

# --- Bot ---
# poll: call new_launches every POLL_SECONDS. webhook: Dexra calls this bot when launches appear.
MODE=poll
# SOL spent per buy. Must not be above MAX_TRADE_SOL.
BUY_SOL=0.01

# --- Intake ---
# Seconds between new_launches calls. Each call uses credits; see the README.
POLL_SECONDS=60
# Launch window per poll, in minutes (1 to 60).
LAUNCH_MINUTES=5
# Skip launches with less liquidity than this (USD). 0 turns the filter off.
MIN_LIQUIDITY_USD=5000
# Comma-separated, empty for all: pump_fun, letsbonk, raydium_launchlab, meteora_dbc, pump_swap, raydium_amm_v4, raydium_cpmm
PLATFORMS=

# --- Webhook mode ---
# Address and port the webhook server listens on.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
WEBHOOK_PATH=/dexra
# Public HTTPS URL Dexra posts to (ends in WEBHOOK_PATH). Used once to create the launches watch.
WEBHOOK_PUBLIC_URL=
# Minutes between watch runs on Dexra's side (each run uses credits).
WATCH_INTERVAL_MINUTES=2
# The created watch's id and signing secret are saved here (mode 600) and reused on restart.
WATCH_FILE=watch.json
# Set this instead to use a watch you already created; no new watch is made.
DEXRA_WEBHOOK_SECRET=

# --- Risk limits (on top of the core) ---
MAX_BUYS_PER_HOUR=2
MAX_OPEN_POSITIONS=3
# Open positions and recent buys, so limits survive a restart.
POSITIONS_FILE=positions.json

# --- Exits (run only when JUPITER_API_KEY is set; in a dry run they log what they would sell) ---
# Sell after this many minutes. 0 turns it off.
HOLD_MINUTES=30
# Sell when a Jupiter quote values the position this much above cost. 0 turns it off.
TAKE_PROFIT_PCT=50
# Sell when it is this much below cost. 0 turns it off.
STOP_LOSS_PCT=30
# Seconds between exit checks (one Jupiter quote per open position).
EXIT_CHECK_SECONDS=30
